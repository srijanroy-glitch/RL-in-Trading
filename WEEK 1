import numpy as np

# ==============================
# 1. Initializing Arrays
# ==============================

arr = np.array([[1, 2, 4],
                [7, 13, 21]])
print("Shape:", arr.shape)


# ==============================
# 2. Array filled with a constant
# ==============================

n, m = 5, 7
arr_const = np.full((n, m), 7)
print("\nArray filled with 7:\n", arr_const)


# ==============================
# 3. Random array & Identity matrix
# ==============================

RANDOM_ARR = np.random.rand(4, 3, 4)
print("\nRandom Array:\n", RANDOM_ARR)

n = 3
EYE = np.eye(n)
print("\nIdentity Matrix:\n", EYE)


# ==============================
# 4. Reshape, Transpose & Flatten
# ==============================

y = np.array([[1, 2, 3],
              [4, 5, 6]])

y_transpose = y.reshape(3, 2)
y_flattened = y.reshape(-1)

print("\nTranspose:\n", y_transpose)
print("Flattened:", y_flattened)

# Direct methods
print("\nUsing built-ins:")
print(y.T)
print(y.flatten())


# ==============================
# 5. Create array easily + dtype
# ==============================

arr = np.arange(1, 13).reshape(3, 4)
print("\nArray:\n", arr)
print("Datatype:", arr.dtype)


# ==============================
# 6. Random numbers (0 to 1)
# ==============================

arr_random = np.random.rand(3, 4)
print("\nRandom (0,1):\n", arr_random)


# ==============================
# 7. Random seed (reproducibility)
# ==============================

np.random.seed(31)
arr_seeded = np.random.rand(3, 4)
print("\nSeeded Random:\n", arr_seeded)


# ==============================
# 8. Random integers [5,12)
# ==============================

arr_int = np.random.randint(5, 12, size=(2, 4))
print("\nRandom Integers:\n", arr_int)


# ==============================
# 9. Copies vs References
# ==============================

arr = np.random.randint(10, size=6)
new_arr = arr.copy()
arr[0] = -39

print("\nOriginal:", arr)
print("Copy:", new_arr)


# ==============================
# 10. Aggregation Functions
# ==============================

arr = np.arange(10).reshape(2, 5)
print("\nSum:", arr.sum())
print("Mean:", arr.mean())
print("Std:", arr.std())
print("Min:", arr.min())


# ==============================
# 11. Aggregation with axis
# ==============================

arr = np.array([[1, 2, 9],
                [3, 4, 5],
                [-3, 8, 7]])

print("\nMax (axis=0):", arr.max(axis=0))
print("Max (axis=1):", arr.max(axis=1))
print("Overall Max:", arr.max())
print("Overall Min:", arr.min())
print("Overall Mean:", arr.mean())


# ==============================
# 12. Broadcasting
# ==============================

arr = np.random.randint(12, size=3)
arr_square = arr ** 2

print("\nArray:", arr)
print("Squared:", arr_square)


# ==============================
# 13. Broadcasting example
# ==============================

arr1 = np.arange(12).reshape(3, 4)
arr2 = np.arange(4)

print("\nBroadcasting Addition:\n", arr1 + arr2)
